# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Operating-system and editor files
.DS_Store
Thumbs.db
.vscode/
*.swp

# Local data downloaded by scripts/refresh_data.py
data/*
!data/ANOMALIES.md
!data/raw/
!data/interim/
!data/processed/
data/raw/*
!data/raw/cfe_vx/
!data/raw/indices/
!data/raw/etp/
data/raw/cfe_vx/*
!data/raw/cfe_vx/.gitkeep
data/raw/indices/*
!data/raw/indices/.gitkeep
data/raw/etp/*
!data/raw/etp/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Exploratory notebooks are not part of the supported pipeline
notebooks/*
!notebooks/.gitkeep

# Generated result details. Markdown reports remain viewable snapshots.
results/*
!results/
!results/*.md

# Binary and tabular intermediates
*.parquet
*.pickle
*.pkl

# Logs, local settings, and credentials
*.log
.env
.env.*
*.pem
*.key
credentials.json
